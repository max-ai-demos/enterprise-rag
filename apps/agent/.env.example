OPENAI_API_KEY=sk-...
DATABASE_URL=mysql+pymysql://root:<password>@localhost:3306/enterprise_rag?charset=utf8mb4
UPLOAD_DIR=../../data/uploads
DEMO_DIR=../../data/demo
RERANK_SCORE_THRESHOLD=0.3

# --- PDF 解析器（商业化升级用）---
# 默认 pymupdf，无需配置。切换为 "datalab" 或 "mineru" 时填写对应凭证。
PDF_PARSER_PROVIDER=pymupdf

# Datalab — 注册：https://www.datalab.to
DATALAB_API_KEY=
DATALAB_BASE_URL=https://www.datalab.to
DATALAB_OUTPUT_FORMAT=json
DATALAB_USE_LLM=false
DATALAB_FORCE_OCR=false
DATALAB_MAX_FILE_SIZE_MB=50
DATALAB_MAX_POLL_SECONDS=300
DATALAB_POLL_INTERVAL=5

# MinerU — 部署：https://github.com/opendatalab/MinerU
MINERU_BASE_URL=
